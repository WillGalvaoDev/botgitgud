# BotGITGUD -- template de ambiente para PRODUCAO (Linux/systemd).
#
# Copie para /opt/botgitgud/.env, preencha os valores marcados OBRIGATORIO e
# restrinja as permissoes:
#
#     sudo -u botgitgud cp deploy/env.example /opt/botgitgud/.env
#     sudo -u botgitgud chmod 600 /opt/botgitgud/.env
#
# Este arquivo NAO contem segredo nenhum e nunca deve conter: os valores
# abaixo sao vazios de proposito. `botgitgud.cli deploy-validate-env` recusa
# um .env que ainda tenha placeholder, justamente para um template copiado
# nunca ser confundido com um ambiente configurado.
#
# Diferenca para o `.env.example` da raiz do repositorio: aquele documenta
# TODOS os campos de Settings (referencia de desenvolvimento, verificado por
# teste); este lista apenas o subconjunto que um deploy de producao precisa
# decidir. Qualquer campo omitido aqui usa o default de src/botgitgud/config.py.
#
# ASCII apenas, mesma convencao de scripts/ -- este arquivo e lido por shell
# (EnvironmentFile do systemd) alem de Python.

# -- OBRIGATORIO: credenciais -------------------------------------------------
# Sem estas cinco o bot nao sobe. Nenhuma delas tem default.
DISCORD_TOKEN=
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# -- OBRIGATORIO em producao: caminho de dados --------------------------------
# Absoluto de proposito. O default (`data`) e relativo e resolveria contra o
# cwd do processo; sob systemd isso depende do WorkingDirectory da unit, e um
# caminho absoluto remove a duvida.
DATA_DIR=/opt/botgitgud/data

# -- Operacao (opcionais; defaults em src/botgitgud/config.py) ----------------
LOG_LEVEL=INFO
LOG_JSON=false
# Grace period do shutdown gracioso. Se aumentar aqui, aumente tambem o
# TimeoutStopSec da unit systemd -- ver deploy/systemd/botgitgud.service.
SUPERVISOR_STOP_GRACE_S=30.0
