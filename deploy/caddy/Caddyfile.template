# BotGITGUD -- Caddy reverse-proxy template (CL.9A, preparacao offline).
#
# NAO instalado/ativado automaticamente por este repositorio. Ver
# deploy/install-caddy.sh e docs/linux-deployment.md (secao CL.9A) para o
# fluxo de instalacao futuro, na VM real.
#
# Fluxo:
#   Internet -> HTTPS :443 -> Caddy -> 127.0.0.1:8080 (ReportServer, CL.3)
#
# O ReportServer (bot/report_server.py) continua ligado SOMENTE em
# loopback -- este e o UNICO processo autorizado a falar com a Internet
# nesta arquitetura.
#
# O marcador de dominio no cabecalho do bloco abaixo e substituido pelo
# dominio real por `deploy/install-caddy.sh` (via `botgitgud.cli
# deploy-render-caddyfile`), NUNCA a mao neste arquivo versionado, e NUNCA
# com um dominio inventado -- ver ops/caddy_config.py::validate_caddy_domain.
# O marcador aparece UMA UNICA vez neste arquivo, de proposito: a
# substituicao e um `str.replace` simples, e uma segunda ocorrencia (por
# exemplo, citada aqui em prosa) seria corrompida junto.

__BOTGITGUD_DOMAIN__ {
	# TLS gerenciado automaticamente pelo Caddy (ACME/Let's Encrypt) --
	# NUNCA certificado local/self-signed em producao. O desafio HTTP-01
	# do ACME precisa da porta 80 livre (ver docs/linux-deployment.md,
	# secao firewall). Nenhuma diretiva `tls` aqui: o comportamento
	# automatico e o correto.

	# Somente a rota da capability link (CL.2/CL.3) e encaminhada.
	# NUNCA outro host/porta que nao 127.0.0.1:8080 -- 0.0.0.0:8080
	# exporia o ReportServer inteiro para trafego que nao passou pelo
	# Caddy, inclusive de dentro da propria maquina.
	@report_link path /r/*
	reverse_proxy @report_link 127.0.0.1:8080

	# Deny-by-default: cobre /healthz, /, e qualquer rota futura do
	# ReportServer que ainda nao tenha sido decidida explicitamente como
	# publica. O health check nao e um requisito publico deste projeto --
	# 127.0.0.1:8080/healthz continua disponivel localmente (SSH) para
	# quem opera a maquina. Nenhum header/redirect e adicionado aqui: o
	# 404 e generico, sem vazar que a rota existe internamente.
	respond 404

	# NUNCA adicione um bloco `log` neste site -- ver
	# docs/linux-deployment.md, secao "capability token e logs". O
	# formato padrao de access log do Caddy inclui a linha de requisicao
	# inteira (`GET /r/<token> HTTP/1.1`): o capability token iria para o
	# disco em texto puro. Sem este bloco, o Caddy nao grava log de
	# acesso por requisicao -- so eventos de start/stop/reload no
	# stderr/journal, sem URI.
}
