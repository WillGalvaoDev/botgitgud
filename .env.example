DISCORD_TOKEN=
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# Operação geral. Defaults do Settings; ajuste conforme o ambiente.
DATA_DIR=data
LOG_LEVEL=INFO
LOG_JSON=false
# Trilha operacional duravel (JSON Lines) em <DATA_DIR>/logs. Rotacao por
# tamanho; teto de disco = LOG_MAX_BYTES * (LOG_BACKUP_COUNT + 1).
LOG_MAX_BYTES=10000000
LOG_BACKUP_COUNT=5
MAX_WORKERS=4

# Supervisao externa ao processo `serve` (B6) -- `python -m botgitgud.cli
# supervise`. O supervisor nunca fala com WCL/Discord: so relanca o filho.
SUPERVISOR_POLL_INTERVAL_S=2.0
SUPERVISOR_BACKOFF_BASE_S=2.0
SUPERVISOR_BACKOFF_MAX_S=60.0
SUPERVISOR_BACKOFF_RESET_AFTER_S=300.0
SUPERVISOR_STORM_THRESHOLD=5
SUPERVISOR_STORM_WINDOW_S=600.0
SUPERVISOR_STOP_GRACE_S=30.0
# Intervalo de polling do arquivo control/stop.request DENTRO do bot.
BOT_STOP_POLL_INTERVAL_S=1.0

# Warcraft Logs: rede, retry e proteção do orçamento compartilhado.
WCL_CONNECT_TIMEOUT_S=5.0
WCL_READ_TIMEOUT_S=30.0
WCL_POOL_TIMEOUT_S=60.0
WCL_MAX_ATTEMPTS=4
WCL_BACKOFF_BASE_S=1.0
WCL_BACKOFF_FACTOR=2.0
WCL_RATE_LIMIT_CACHE_TTL_S=60.0
# Jobs não devem consumir a reserva abaixo deste piso.
API_POINTS_FLOOR=1000.0
HOT_PATH_RESERVE=1000.0
COLD_BUILD_SAFETY_MARGIN=250.0
# Modo prewarm (build-cohort explicito): respeita o piso da API, mas nao a
# reserva interativa — ver docs/production-readiness-cold-build.md.
COLD_BUILD_BATCH_SAFETY_MARGIN=100.0
# Banda de incerteza dos PONTOS por query, derivada do custo esperado (1,2x).
COLD_BUILD_COST_UNCERTAINTY=1.2
# Medido no smoke real de 2026-08-25: 2.131,29 pts / 1.508 queries.
COLD_BUILD_POINTS_PER_QUERY=1.413
# Medido no prewarm real de 2026-08-25: 864 queries / 37 referencias. O valor
# anterior (15) foi falsificado por essa medicao.
COLD_BUILD_QUERIES_PER_REFERENCE=23.4
# Banda de incerteza das QUERIES, separada da banda de pontos: as duas
# variaveis erraram em direcoes opostas no smoke real.
COLD_BUILD_QUERIES_UNCERTAINTY=1.3
COLD_BUILD_FIXED_QUERIES=6
# Referencias por lote entre duas medicoes reais do orcamento durante um build
# incremental — e o que limita o quanto o consumo pode passar do previsto.
COLD_BUILD_CHUNK_REFERENCES=5
# Espera padrao antes de reconsiderar um job adiado quando a WCL nao informou
# `pointsResetIn`.
COLD_BUILD_DEFER_RETRY_S=600.0

# Blizzard API: rede e retry.
BLIZZARD_CONNECT_TIMEOUT_S=5.0
BLIZZARD_READ_TIMEOUT_S=10.0
BLIZZARD_MAX_ATTEMPTS=3
BLIZZARD_BACKOFF_BASE_S=1.0
BLIZZARD_BACKOFF_FACTOR=2.0

# Metodologia: mudar estes valores altera comparações entre execuções.
# O settings_hash do RunManifest registra essa deriva.
GAP_PENALTY_S=25.0
MAJOR_THRESHOLD_S=90.0
MIN_ELIGIBLE_INTERVAL_S=15.0
MIN_ELIGIBLE_PRESENCE=0.70
SINGLE_USE_N_THRESHOLD=1.5
DISCORD_CHUNK_MAX_LEN=1900
SANITY_BAND_PCT=0.35
POSITIONAL_BAND_PCT=0.12
POSITIONAL_MIN_N=8
COHORT_MIN_HARD=8
COHORT_MIN_WARN=20
COHORT_MAX=100
MAX_RANKING_PAGES=10
