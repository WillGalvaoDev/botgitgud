DISCORD_TOKEN=
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# Operação geral. Defaults do Settings; ajuste conforme o ambiente.
DATA_DIR=data
LOG_LEVEL=INFO
LOG_JSON=false
MAX_WORKERS=4

# Warcraft Logs: rede, retry e proteção do orçamento compartilhado.
WCL_CONNECT_TIMEOUT_S=5.0
WCL_READ_TIMEOUT_S=30.0
WCL_POOL_TIMEOUT_S=60.0
WCL_MAX_ATTEMPTS=4
WCL_BACKOFF_BASE_S=1.0
WCL_BACKOFF_FACTOR=2.0
WCL_RATE_LIMIT_CACHE_TTL_S=60.0
# Jobs não devem consumir a reserva abaixo deste piso.
API_POINTS_FLOOR=1000.0
HOT_PATH_RESERVE=1000.0
COLD_BUILD_SAFETY_MARGIN=250.0
# Modo prewarm (build-cohort explicito): respeita o piso da API, mas nao a
# reserva interativa — ver docs/production-readiness-cold-build.md.
COLD_BUILD_BATCH_SAFETY_MARGIN=100.0
# Banda de incerteza do custo, derivada do custo esperado (1,2x).
COLD_BUILD_COST_UNCERTAINTY=1.2
# Medido no smoke real de 2026-08-25: 2.131,29 pts / 1.508 queries.
COLD_BUILD_POINTS_PER_QUERY=1.413
COLD_BUILD_QUERIES_PER_REFERENCE=15
COLD_BUILD_FIXED_QUERIES=6

# Blizzard API: rede e retry.
BLIZZARD_CONNECT_TIMEOUT_S=5.0
BLIZZARD_READ_TIMEOUT_S=10.0
BLIZZARD_MAX_ATTEMPTS=3
BLIZZARD_BACKOFF_BASE_S=1.0
BLIZZARD_BACKOFF_FACTOR=2.0

# Metodologia: mudar estes valores altera comparações entre execuções.
# O settings_hash do RunManifest registra essa deriva.
GAP_PENALTY_S=25.0
MAJOR_THRESHOLD_S=90.0
MIN_ELIGIBLE_INTERVAL_S=15.0
MIN_ELIGIBLE_PRESENCE=0.70
SINGLE_USE_N_THRESHOLD=1.5
DISCORD_CHUNK_MAX_LEN=1900
SANITY_BAND_PCT=0.35
POSITIONAL_BAND_PCT=0.12
POSITIONAL_MIN_N=8
COHORT_MIN_HARD=8
COHORT_MIN_WARN=20
COHORT_MAX=100
MAX_RANKING_PAGES=10
